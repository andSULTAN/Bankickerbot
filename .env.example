# --- Telegram bot ---
BOT_TOKEN=123456:AA...replace_me

# --- Telethon service account (my.telegram.org -> API development tools) ---
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
# Session fayli REPO ICHIDA BO'LMASIN (sirli fayl!)
TG_SESSION_PATH=C:/Users/me/.tgguard/service_account.session

# --- Database ---
DATABASE_URL=postgresql+asyncpg://tgguard:tgguard@localhost:5432/tgguard

# --- Access ---
# Vergul bilan ajratilgan admin user id lar
ADMIN_IDS=111111111,222222222
# Review kanal id si (bot u yerda admin bo'lishi shart), odatda -100... bilan boshlanadi
REVIEW_CHANNEL_ID=-1001234567890

# --- Protected chats ---
# Himoyalanadigan kanal va unga bog'langan muhokama guruhi
CHANNEL_ID=-1009876543210
DISCUSSION_GROUP_ID=-1005555555555

# --- Behaviour ---
# observe = hech qachon avtomatik ban qilmaydi, faqat xabar beradi; enforce = ban qiladi
MODE=observe
SCORING_CONFIG=config/scoring.yaml
LOG_LEVEL=INFO

# --- Docker Compose (VPS) ---
POSTGRES_USER=tgguard
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=tgguard
